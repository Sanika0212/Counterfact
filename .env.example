# Copy to .env (git-ignored) and set ONE key. Only the LLM-judge baseline uses it.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# COUNTERFACT_JUDGE_PROVIDER=openai      # or anthropic, when both keys are set
# COUNTERFACT_JUDGE_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
